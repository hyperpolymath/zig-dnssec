#
# zig-dnssec container image (OCI; podman recommended, any engine works).
#
# Targets:
#   test        build + run the unit/vector/replay tests (default)
#   crosscheck  test + NSD, Unbound, ldns, haproxy for tests/crosscheck/
#   runtime     the dnssec-stub CLI alone on a minimal base
#
#   podman build -f build/container/Containerfile --target test -t zig-dnssec:test .
#   podman build -f build/container/Containerfile --target runtime -t zig-dnssec:latest .
#   podman run --rm zig-dnssec:latest --doh https://dns.quad9.net/dns-query example.com. A
#
# Behind a TLS-intercepting proxy, pass its CA for the build steps only (it is
# not written into any image layer):
#   podman build --secret id=extra-ca,src=/path/to/ca.pem ...
#
# The Zig toolchain is fetched from ziglang.org and checked against the
# SHA-256 published in https://ziglang.org/download/index.json (the same
# values pinned in mise.lock).

ARG ZIG_VERSION=0.17.0
ARG ZIG_SHA256_X86_64=1cbe9df9f27e6b78d14ccbca43b6703a404ef79ef1c463de901d7f088d4e2026
ARG ZIG_SHA256_AARCH64=9e8d11661d4ae3bd57702a3832781e23ad151dde5798e16a5ccd503f65234ff8

# ---------------------------------------------------------------------------
FROM cgr.dev/chainguard/wolfi-base:latest AS toolchain
ARG ZIG_VERSION
ARG ZIG_SHA256_X86_64
ARG ZIG_SHA256_AARCH64
RUN --mount=type=secret,id=extra-ca,required=false \
    set -eu; \
    if [ -s /run/secrets/extra-ca ]; then \
      cat /etc/ssl/certs/ca-certificates.crt /run/secrets/extra-ca > /tmp/ca.pem; \
      export SSL_CERT_FILE=/tmp/ca.pem CURL_CA_BUNDLE=/tmp/ca.pem; \
    fi; \
    apk add --no-cache curl xz; \
    arch="$(uname -m)"; \
    case "$arch" in \
      x86_64) sum="$ZIG_SHA256_X86_64" ;; \
      aarch64) sum="$ZIG_SHA256_AARCH64" ;; \
      *) echo "unsupported architecture $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/zig.tar.xz "https://ziglang.org/download/${ZIG_VERSION}/zig-${arch}-linux-${ZIG_VERSION}.tar.xz"; \
    echo "${sum}  /tmp/zig.tar.xz" | sha256sum -c -; \
    xz -dc /tmp/zig.tar.xz | tar -x -C /opt; \
    mv "/opt/zig-${arch}-linux-${ZIG_VERSION}" /opt/zig; \
    rm -f /tmp/zig.tar.xz /tmp/ca.pem
ENV PATH="/opt/zig:${PATH}"

# ---------------------------------------------------------------------------
FROM toolchain AS test
WORKDIR /src
COPY build.zig build.zig.zon ./
COPY src/ ./src/
COPY tests/ ./tests/
RUN zig build test --summary all && zig build -Doptimize=ReleaseSafe

# ---------------------------------------------------------------------------
FROM test AS crosscheck
RUN --mount=type=secret,id=extra-ca,required=false \
    set -eu; \
    if [ -s /run/secrets/extra-ca ]; then \
      cat /etc/ssl/certs/ca-certificates.crt /run/secrets/extra-ca > /tmp/ca.pem; \
      export SSL_CERT_FILE=/tmp/ca.pem; \
    fi; \
    apk add --no-cache bash nsd unbound ldns-tools haproxy bind-tools openssl gawk; \
    rm -f /tmp/ca.pem
CMD ["bash", "-c", "tests/crosscheck/servers.sh start && tests/crosscheck/run.sh; tests/crosscheck/servers.sh stop"]

# ---------------------------------------------------------------------------
FROM cgr.dev/chainguard/wolfi-base:latest AS runtime
COPY --from=test /src/zig-out/bin/dnssec-stub /usr/local/bin/dnssec-stub
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/dnssec-stub"]
